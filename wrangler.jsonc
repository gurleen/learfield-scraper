{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learfield-scraper",
  "main": "worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/models/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "learfield-scraper-models"
    }
  ],
  "routes": [
    {
      "pattern": "rosters.dragonstv.io",
      "custom_domain": true
    }
  ]
}
