{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "vite.config.ts"]
}
